     public static let wasmNumericalPrimitive = .wasmi32 | .wasmi64 | .wasmf32 | .wasmf64
 
+    // In general most JS variables are heap objects, even boolean literals are heap objects. However, not all heap objects are interesting.
+    // We define interesting heap objects as those that have been shown to cause a heap sandbox bug in the past. As of now the order of interestingness
+    // is: object (13), func (11), string (10), array (5), bigint (2)
+    // definitelyInterestingHeapObject are heap objects where bugs exists in test/mjsunit
+    public static let definitelyInterestingHeapObject = ILType.object() | .iterable | .function()  | .string | .bigint
+    // possiblyInterestingHeapObject are heap objects with no bugs in test/mjsunit (yet)
+    public static let possiblyInterestingHeapObject = .float | .boolean | .regexp | .constructor()
+     // We go for a liberal approach here. Almost everything is a heap object, even null/undefined/bools, surprisingly not int though, but float and bigint are (IIUC).
+    public static let interestingHeapObject = definitelyInterestingHeapObject | possiblyInterestingHeapObject
+    // TODO: Are wasm types interesting heap objects?
+
     //
     // Type testing
     //
