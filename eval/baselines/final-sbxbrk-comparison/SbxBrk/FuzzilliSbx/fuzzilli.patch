 ]
 
+public let HeapCorruptionGenerators: [CodeGenerator] = [
+    CodeGenerator("SandboxCorruptObjGenerator", inputs: .required(.interestingHeapObject)) { b, randomHeapObject in
+        let usingXorInsteadOfSet = Bool.random()
+        let offsetInnerInsteadOfOuter = Bool.random()
+
+        let sandbox = b.createNamedVariable(forBuiltin: "Sandbox")
+        let memoryView = b.construct(
+            b.getProperty("MemoryView", of: sandbox),
+            withArgs: [b.loadInt(0), b.loadInt(0x100000000)]
+        )
+
+        let addrOfRandomHeapObject = b.callMethod("getAddressOf", on: sandbox, withArgs: [randomHeapObject])
+        let objSize = b.callMethod("getSizeOf", on: sandbox, withArgs: [randomHeapObject])
+        // Generate a random number on the swift side bound by the size of the object that is only known on the JS side.
+        let randomNumber =  Int32.random(in: 0...Int32.max) // Avoid using bigints in JS.
+        var addrOfTargetByte: Variable
+        if offsetInnerInsteadOfOuter {
+            // Find one byte within the object.
+            let offsetWithinObject = b.binary(b.loadInt(Int64(randomNumber)), objSize, with: .Mod)
+            addrOfTargetByte = b.binary(addrOfRandomHeapObject, offsetWithinObject, with: .Add)
+        } else {
+            // If the following is true, we will target a byte that is not part of the object itself but instead in its vicinity.
+            let beforeObjectInsteadOfAfter = Bool.random()
+            if beforeObjectInsteadOfAfter {
+                let offsetBeforeObject = b.binary(b.loadInt(Int64(-randomNumber)), objSize, with: .Mod)
+                addrOfTargetByte = b.binary(addrOfRandomHeapObject, offsetBeforeObject, with: .Add)
+            } else {
+                let offset = b.binary(b.loadInt(Int64(randomNumber)), objSize, with: .Mod)
+                let offsetAfterObject = b.binary(offset, objSize, with: .Add)
+                addrOfTargetByte = b.binary(addrOfRandomHeapObject, offsetAfterObject, with: .Add)
+            }
+        }
+
+        if usingXorInsteadOfSet {
+            // xor with random byte
+            let randomByte = Int64.random(in: 0...255)
+            let currentValue = b.callMethod("getUint8", on: memoryView, withArgs: [addrOfTargetByte])
+            let xorResult = b.binary(currentValue, b.loadInt(randomByte), with: .Xor)
+            b.callMethod("setUint8", on: memoryView, withArgs: [addrOfTargetByte, xorResult])
+        } else {
+            // set with random byte
+            let randomByte = Int64.random(in: 0...255)
+            b.callMethod("setUint8", on: memoryView, withArgs: [addrOfTargetByte, b.loadInt(randomByte)])
+        }
+
+    },
+
+    CodeGenerator("SandboxCorruptMapGenerator", inputs: .required(.interestingHeapObject)) { b, randomHeapObject in
+        let usingXorInsteadOfSet = Bool.random()
+
+        let sandbox = b.createNamedVariable(forBuiltin: "Sandbox")
+        let memoryView = b.construct(
+            b.getProperty("MemoryView", of: sandbox),
+            withArgs: [b.loadInt(0), b.loadInt(0x100000000)]
+        )
+
+        let addrOfRandomHeapObject = b.callMethod("getAddressOf", on: sandbox, withArgs: [randomHeapObject])
+        let addrOfRandomHeapObjectMap = b.callMethod("getUint32", on: memoryView, withArgs: [addrOfRandomHeapObject, b.loadBool(true)])
+        // Calculate the random offset on the Swift side because otherwise the program will become inherently non-deterministic.
+        let randomOffset = Int64.random(in: 0...0x100)
+        let addrOfTargetByte = b.binary(addrOfRandomHeapObjectMap, b.loadInt(randomOffset), with: .Add)
+
+        if usingXorInsteadOfSet {
+            let randomByte = Int64.random(in: 0...255)
+            let currentValue = b.callMethod("getUint8", on: memoryView, withArgs: [addrOfTargetByte])
+            let xorResult = b.binary(currentValue, b.loadInt(randomByte), with: .Xor)
+            b.callMethod("setUint8", on: memoryView, withArgs: [addrOfTargetByte, xorResult])
+        } else {
+            let randomByte = Int64.random(in: 0...255)
+            b.callMethod("setUint8", on: memoryView, withArgs: [addrOfTargetByte, b.loadInt(randomByte)])
+        }
+    }
+]
